{
  "name": "intercepta-payment-gate-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "node scripts/dev.mjs",
    "doctor": "node scripts/doctor.mjs",
    "demo:build": "node scripts/build-offline-demo.mjs",
    "demo:serve": "npm run demo:build && tsx apps/demo/src/index.ts",
    "demo:test": "vitest run shared/demo-assessment.test.ts apps/demo/src/app.test.ts tests/symphony-step2/step2-ui.test.ts --maxWorkers=1",
    "typecheck": "tsc --noEmit",
    "ci:local": "node scripts/ci-local.mjs",
    "test": "vitest run --maxWorkers=2",
    "build": "vite build --config apps/web/vite.config.ts",
    "demo:test:step3": "vitest run shared/demo-requests.test.ts shared/demo-risk-evidence.test.ts apps/buyer/src/intercepta-response.test.ts apps/buyer/src/intercepta.test.ts apps/web/src/api.test.ts apps/web/src/DemoRiskEvidence.test.tsx tests/symphony-step3/state tests/symphony-step3/risk --maxWorkers=1",
    "private:risk:build": "node scripts/build-private-risk.mjs",
    "private:risk": "node --env-file-if-exists=.env --import tsx apps/private-risk/src/index.ts",
    "demo:prepare": "npm run private:risk:build",
    "demo:check": "node --env-file-if-exists=.env scripts/check-demo.mjs",
    "demo:live": "npm run private:risk"
  },
  "dependencies": {
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "@x402/express": "2.27.0",
    "@x402/fetch": "2.27.0",
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}

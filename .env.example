# Testnet only. Copy to .env locally; never commit secrets.
SELLER_PORT=4032
BUYER_PORT=4031
SELLER_URL=http://127.0.0.1:4032
FACILITATOR_URL=https://x402.org/facilitator
# Your isolated test merchant address (public, no private key needed by seller).
SELLER_PAY_TO=
# Independent test wallet only; not a wallet holding real funds.
BUYER_PRIVATE_KEY=
INTERCEPTA_API_KEY=
# Fail closed by default. Configuration alone never bypasses the risk gate.
ENABLE_TESTNET_PAYMENTS=false
# Application AI is not configured in the first local slice; do not reuse company keys.
